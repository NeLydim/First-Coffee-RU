class LoadError(Exception):
    pass


class BadFontFile(Exception):
    pass


def _be16(blob, ofs):
    return struct.unpack_from(">H", blob, ofs)[0]


def _be32(blob, ofs):
    return struct.unpack_from(">I", blob, ofs)[0]


def _fixed16(blob, ofs):
    return struct.unpack_from(">i", blob, ofs)[0] / 65536.0


def detect_container(head_bytes):
    head_bytes = bytes(head_bytes[:8])
    if head_bytes[:4] in SFNT_MAGIC or head_bytes[:4] == b"ttcf":
        return "font"
    if head_bytes[:4] in (b"wOFF", b"wOF2"):
        return "woff"
    if head_bytes[:4] in (b"PK\x03\x04", b"PK\x05\x06"):
        return "zip"
    trimmed = head_bytes.lstrip()
    if trimmed[:1] == b"<" or trimmed[:1] == b"{":
        return "html"
    return "unknown"


def _read_name_table(blob, ofs):
    n_items = _be16(blob, ofs + 2)
    str_base = ofs + _be16(blob, ofs + 4)
    winner = {}
    for pos in range(n_items):
        rec_at = ofs + 6 + 12 * pos
        plat_id, enc_id, lang_id, name_id, length, str_off = struct.unpack_from(">HHHHHH", blob, rec_at)
        if name_id not in (1, 2, 4, 16, 17):
            continue
        raw_face = blob[str_base + str_off:str_base + str_off + length]
        if plat_id in (0, 3):
            line_text = raw_face.decode("utf-16-be", "replace")
            rank_v = 0 if (plat_id == 3 and lang_id == 0x409) else (1 if plat_id == 3 else 3)
        elif plat_id == 1 and enc_id == 0:
            line_text = raw_face.decode("mac_roman", "replace")
            rank_v = 2
        else:
            continue
        line_text = line_text.strip("\x00 ").strip()
        if line_text and (name_id not in winner or rank_v < winner[name_id][0]):
            winner[name_id] = (rank_v, line_text)
    return {key_: vv[1] for key_, vv in winner.items()}


def _glyph_lookup(blob, ofs):
    total_n = _be16(blob, ofs + 2)
    rank_table = {(3, 10, 12): 0, (0, 4, 12): 1, (0, 6, 12): 1, (3, 1, 4): 2,
                  (0, 3, 4): 3, (0, 4, 4): 3, (0, 1, 4): 4, (0, 0, 4): 4}
    winner = None
    winner_rank = 99
    for pos in range(total_n):
        rec_at = ofs + 4 + 8 * pos
        if rec_at + 8 > len(blob):
            break
        plat_id, enc_id = _be16(blob, rec_at), _be16(blob, rec_at + 2)
        sub_at = ofs + _be32(blob, rec_at + 4)
        if sub_at + 4 > len(blob):
            continue
        table_fmt = _be16(blob, sub_at)
        rank_v = rank_table.get((plat_id, enc_id, table_fmt))
        if rank_v is None:
            if table_fmt in (4, 12) and plat_id in (0, 3):
                rank_v = 5
            else:
                continue
        if rank_v < winner_rank:
            winner_rank, winner = rank_v, (table_fmt, sub_at)
    if winner is None:
        return lambda codepoint: 0
    table_fmt, sub_at = winner
    if table_fmt == 12:
        cnt = min(_be32(blob, sub_at + 12), (len(blob) - sub_at - 16) // 12)
        seg_groups = [struct.unpack_from(">III", blob, sub_at + 16 + 12 * glyph_raw) for glyph_raw in range(cnt)]

        def seg12_find(codepoint):
            for seg_start, seg_end, glyph_id in seg_groups:
                if seg_start <= codepoint <= seg_end:
                    return glyph_id + (codepoint - seg_start)
            return 0
        return seg12_find

    seg_double = _be16(blob, sub_at + 6)
    seg_count = seg_double // 2
    end_at = sub_at + 14
    start_at = end_at + seg_double + 2
    delta_at = start_at + seg_double
    range_at = delta_at + seg_double

    def seg4_find(codepoint):
        if codepoint > 0xFFFF:
            return 0
        for pos in range(seg_count):
            if codepoint > _be16(blob, end_at + 2 * pos):
                continue
            seg_start = _be16(blob, start_at + 2 * pos)
            if codepoint < seg_start:
                return 0
            id_delta = _be16(blob, delta_at + 2 * pos)
            range_off = _be16(blob, range_at + 2 * pos)
            if range_off == 0:
                return (codepoint + id_delta) & 0xFFFF
            glyph_addr = range_at + 2 * pos + range_off + 2 * (codepoint - seg_start)
            if glyph_addr + 2 > len(blob):
                return 0
            glyph_raw = _be16(blob, glyph_addr)
            return (glyph_raw + id_delta) & 0xFFFF if glyph_raw else 0
        return 0
    return seg4_find


def style_from_filename(nm):
    anchor = os.path.splitext(os.path.basename(nm or ""))[0].lower()
    squashed = re.sub(r"[\s_\-.]+", "", anchor)
    slanted = "italic" in squashed or "oblique" in squashed
    weight_words = (("extralight", 200), ("ultralight", 200), ("semibold", 600), ("demibold", 600),
                    ("extrabold", 800), ("ultrabold", 800), ("hairline", 100), ("thin", 100),
                    ("light", 300), ("medium", 500), ("regular", 400), ("normal", 400), ("book", 400),
                    ("bold", 700), ("black", 900), ("heavy", 900))
    for token, heaviness in weight_words:
        if token in squashed:
            return heaviness, slanted
    return 400, slanted


def _round_weight(wt):
    if 0 < wt < 10:
        wt *= 100
    if wt <= 0:
        return 400
    return max(100, min(900, int(round(wt / 100.0)) * 100))


def inspect_font(blob, nm="", face_index=0):
    blob = bytes(blob)
    if len(blob) < 12:
        raise BadFontFile("файл слишком маленький")
    anchor = 0
    is_ttc = blob[:4] == b"ttcf"
    if is_ttc:
        total_n = _be32(blob, 8)
        if total_n == 0 or 12 + 4 * total_n > len(blob):
            raise BadFontFile("повреждённая коллекция шрифтов")
        anchor = _be32(blob, 12 + 4 * (face_index if face_index < total_n else 0))
    if blob[anchor:anchor + 4] not in SFNT_MAGIC:
        raise BadFontFile("неизвестный формат шрифта")
    table_count = _be16(blob, anchor + 4)
    if not 1 <= table_count <= 512:
        raise BadFontFile("повреждённый заголовок шрифта")
    table_map = {}
    for pos in range(table_count):
        rec_at = anchor + 12 + 16 * pos
        if rec_at + 16 > len(blob):
            raise BadFontFile("файл обрезан — скачайте его заново")
        tag4 = blob[rec_at:rec_at + 4].decode("latin-1")
        ofs, length = _be32(blob, rec_at + 8), _be32(blob, rec_at + 12)
        if ofs + length > len(blob):
            raise BadFontFile("таблица «%s» выходит за конец файла — файл повреждён или скачан не полностью" % tag4.strip())
        table_map[tag4] = (ofs, length)
    if "cmap" not in table_map:
        raise BadFontFile("в шрифте нет таблицы символов (cmap)")
    if not any(tt in table_map for tt in ("glyf", "CFF ", "CFF2")):
        raise BadFontFile("в шрифте нет контуров глифов")

    facts = {
        "format": "OpenType (CFF)" if blob[anchor:anchor + 4] == b"OTTO" else "TrueType",
        "collection": is_ttc,
        "size": len(blob),
        "family": "", "subfamily": "", "full_name": "",
        "weight": 0, "italic": False, "variable": False, "axes": {},
        "glyphs": 0, "latin": False, "cyrillic": False, "digits": False,
    }
    if is_ttc:
        facts["format"] += ", коллекция"
    try:
        if "name" in table_map:
            name_rows = _read_name_table(blob, table_map["name"][0])
            facts["family"] = name_rows.get(16) or name_rows.get(1) or ""
            facts["subfamily"] = name_rows.get(17) or name_rows.get(2) or ""
            facts["full_name"] = name_rows.get(4) or ""
    except Exception:
        pass
    heaviness = 0
    slanted = None
    try:
        if "OS/2" in table_map and table_map["OS/2"][1] >= 64:
            tbl_off = table_map["OS/2"][0]
            heaviness = _be16(blob, tbl_off + 4)
            slanted = bool(_be16(blob, tbl_off + 62) & 0x01)
    except Exception:
        pass
    try:
        if slanted is None and "head" in table_map:
            slanted = bool(_be16(blob, table_map["head"][0] + 44) & 0x02)
    except Exception:
        pass
    hint_weight, hint_italic = style_from_filename(facts["subfamily"] or nm)
    facts["weight"] = _round_weight(heaviness) if heaviness else hint_weight
    facts["italic"] = bool(slanted) if slanted is not None else hint_italic
    try:
        if "maxp" in table_map:
            facts["glyphs"] = _be16(blob, table_map["maxp"][0] + 4)
    except Exception:
        pass
    try:
        if "fvar" in table_map:
            tbl_off = table_map["fvar"][0]
            axis_base, n_items, byte_size = _be16(blob, tbl_off + 4), _be16(blob, tbl_off + 8), _be16(blob, tbl_off + 10)
            axis_map = {}
            for pos in range(n_items):
                axis_at = tbl_off + axis_base + byte_size * pos
                tag4 = blob[axis_at:axis_at + 4].decode("latin-1")
                axis_map[tag4] = [_fixed16(blob, axis_at + 4), _fixed16(blob, axis_at + 8), _fixed16(blob, axis_at + 12)]
            facts["variable"] = bool(axis_map)
            facts["axes"] = axis_map
    except Exception:
        pass
    try:
        glyph_of = _glyph_lookup(blob, table_map["cmap"][0])
        facts["latin"] = all(glyph_of(ord(el)) for el in "AZaz")
        facts["cyrillic"] = all(glyph_of(codepoint) for codepoint in (0x0410, 0x042F, 0x0430, 0x044F, 0x0401, 0x0451))
        facts["digits"] = all(glyph_of(ord(el)) for el in "0123456789")
    except Exception:
        pass
    if not facts["family"]:
        facts["family"] = os.path.splitext(os.path.basename(nm or "font"))[0]
    return facts


def _face_of(heft, slanted):
    if heft == "regular":
        return "italic" if slanted else "regular"
    return heft + ("_italic" if slanted else "")


def asset_face(fpath):
    px = str(fpath or "").lower()
    if not px:
        return None
    anchor = px.rsplit("/", 1)[-1]
    if "emoji" in px or anchor.startswith(("num.", "impact")):
        return "special"
    if "mono" in px or "courier" in px:
        return "mono"
    slanted = "italic" in px or "oblique" in px
    if "medium" in px:
        source_kind = "medium"
    elif any(key_ in px for key_ in ("bold", "black", "heavy")):
        source_kind = "bold"
    else:
        source_kind = "regular"
    face = _face_of(source_kind, slanted)
    if anchor.startswith("mw_") or "merriweather" in px or ("serif" in px and "sans" not in px):
        return "serif_" + face
    return face


def family_type_of(nm):
    cnt = str(nm or "").strip().lower()
    if not cnt or cnt in ("default", "system-ui", "arial", "helvetica"):
        return "sans"
    if "mono" in cnt or cnt.startswith("courier"):
        return "mono"
    if cnt.startswith(("sans-serif", "roboto", "google-sans", "sans")):
        if "medium" in cnt or "semibold" in cnt:
            return "sans-medium"
        if "black" in cnt or "bold" in cnt:
            return "sans-bold"
        return "sans"
    if cnt.startswith("serif") or ("serif" in cnt and "sans" not in cnt):
        return "serif"
    return None


def face_for_style(style_n):
    return ("regular", "bold", "italic", "bold_italic")[int(style_n) & 0x03]


def face_for_weight(heaviness, slanted):
    heaviness = int(heaviness)
    source_kind = "bold" if heaviness >= 600 else ("medium" if heaviness >= 450 else "regular")
    return _face_of(source_kind, bool(slanted))


def face_for_family(fam_type, style_n):
    style_n = int(style_n) & 0x03
    if fam_type == "mono":
        return "mono"
    if fam_type == "serif":
        return "serif_" + face_for_style(style_n)
    if fam_type == "sans-medium" and not style_n & ST_BOLD:
        return "medium_italic" if style_n & ST_ITALIC else "medium"
    if fam_type == "sans-bold":
        return "bold_italic" if style_n & ST_ITALIC else "bold"
    return face_for_style(style_n)


def derived_face(raw_face, style_n):
    style_n = int(style_n) & 0x03
    if raw_face in ("mono", "special"):
        return raw_face
    prefix_s = ""
    if raw_face.startswith("serif_"):
        prefix_s, raw_face = "serif_", raw_face[6:]
    source_kind = raw_face.replace("_italic", "")
    if source_kind == "italic":
        source_kind = "regular"
    if style_n & ST_BOLD:
        source_kind = "bold"
    return prefix_s + _face_of(source_kind, bool(style_n & ST_ITALIC))


def _filename_rank(nm):
    low_name = nm.lower()
    mm = re.search(r"(\d+)pt", low_name)
    return (int(mm.group(1)) if mm else 0, "variable" in low_name, len(low_name), low_name)


def spread_family(found_fonts):
    static_fonts = [el for el in found_fonts if not el["info"].get("variable")]
    variable_fonts = [el for el in found_fonts if el["info"].get("variable")]
    taken = set()

    def take(pool_list, slanted, weight_order):
        for wt in weight_order:
            mm = [el for el in pool_list if bool(el["info"].get("italic")) == slanted
                  and el["info"].get("weight") == wt and id(el) not in taken]
            if mm:
                el = min(mm, key=lambda elem: _filename_rank(elem["name"]))
                taken.add(id(el))
                return el
        return None

    face_slots = {}
    regular_tf = take(static_fonts, False, (400, 300, 500))
    if regular_tf is None:
        if variable_fonts:
            upright_list = [el for el in variable_fonts if not el["info"].get("italic")] or variable_fonts
            face_slots["regular"] = min(upright_list, key=lambda elem: _filename_rank(elem["name"]))
            slanted_list = [el for el in variable_fonts if el["info"].get("italic")]
            if slanted_list:
                face_slots["italic"] = min(slanted_list, key=lambda elem: _filename_rank(elem["name"]))
            return face_slots
        pool_list = [el for el in static_fonts if not el["info"].get("italic")] or static_fonts or found_fonts
        face_slots["regular"] = min(pool_list, key=lambda el: (abs(el["info"].get("weight", 400) - 400), _filename_rank(el["name"])))
        return face_slots
    face_slots["regular"] = regular_tf
    for face, slanted, weight_order in (("bold", False, (700, 800, 600)),
                                        ("medium", False, (500, 600)),
                                        ("italic", True, (400, 300)),
                                        ("bold_italic", True, (700, 800, 600)),
                                        ("medium_italic", True, (500, 600))):
        el = take(static_fonts, slanted, weight_order)
        if el is not None:
            face_slots[face] = el
    return face_slots


def parse_link(line_text):
    text_s = str(line_text or "").strip().strip("\"'").strip()
    if not text_s:
        return None, None
    if text_s.startswith("content://"):
        return "uri", text_s
    if text_s.startswith("file://"):
        return "path", unquote(text_s[7:])
    if text_s.startswith("/"):
        return "path", text_s
    if not re.match(r"^https?://", text_s, re.I):
        text_s = "https://" + text_s
    mm = re.match(r"^https?://(?:www\.)?github\.com/([^/]+)/([^/]+)/(?:blob|raw)/([^?#]+)", text_s, re.I)
    if mm:
        return "url", "https://raw.githubusercontent.com/%s/%s/%s" % mm.groups()
    mm = re.match(r"^https?://drive\.google\.com/file/d/([^/?#]+)", text_s, re.I)
    if mm:
        return "url", "https://drive.google.com/uc?export=download&id=" + mm.group(1)
    if re.match(r"^https?://(?:www\.)?dropbox\.com/", text_s, re.I):
        text_s = re.sub(r"([?&])dl=0", r"\1dl=1", text_s)
        if "dl=1" not in text_s:
            text_s += ("&" if "?" in text_s else "?") + "dl=1"
    return "url", text_s


def link_filename(link):
    try:
        fpath = urlparse(link).path
        nm = unquote(fpath.rsplit("/", 1)[-1])
        return nm or "font"
    except Exception:
        return "font"


def clean_filename(nm):
    nm = os.path.basename(str(nm or "font"))
    nm = re.sub(r"[^\w.\-() ]+", "_", nm, flags=re.UNICODE).strip() or "font"
    return nm[:96]


def human_size(cnt):
    cnt = int(cnt or 0)
    if cnt >= 1024 * 1024:
        return "%.1f МБ" % (cnt / 1048576.0)
    if cnt >= 1024:
        return "%d КБ" % round(cnt / 1024.0)
    return "%d Б" % cnt


def _axis_clip(new_value, axis_range):
    lower, _mid, upper = axis_range
    return max(lower, min(upper, new_value))


def _as_int(elem, fallback=0):
    try:
        return int(elem)
    except Exception:
        try:
            return int(elem.intValue())
        except Exception:
            return fallback


_local = threading.local()


def _bypassed():
    return getattr(_local, "level", 0) > 0


# Пока активен, хуки плагина на этом потоке молчат — иначе наши собственные вызовы
# Typeface.create() перехватывались бы. Счётчик, чтобы вложенный блок не сбросил внешний.
class _Bypass:
    def __enter__(self):
        _local.level = getattr(_local, "level", 0) + 1
        return self

    def __exit__(self, *exc_info):
        _local.level = max(0, getattr(_local, "level", 1) - 1)
        return False


# find_class() в exteraGram отдаёт прокси Chaquopy без getDeclaredMethod/getDeclaredFields,
# поэтому настоящий java.lang.Class берётся через Class.forName с загрузчиком приложения.
class Reflect:
    _memo = {}
    BOXES = {"int": "java.lang.Integer", "float": "java.lang.Float",
             "boolean": "java.lang.Boolean", "long": "java.lang.Long"}

    @classmethod
    def type_of(cls, nm):
        if nm in cls._memo:
            return cls._memo[nm]
        el = None
        if nm in cls.BOXES:
            try:
                el = jclass(cls.BOXES[nm]).TYPE
            except Exception:
                el = None
        else:
            try:
                class_loader = ApplicationLoader.applicationContext.getClassLoader()
                el = Class.forName(nm, False, class_loader)
            except Exception:
                try:
                    el = Class.forName(nm)
                except Exception:
                    el = None
        cls._memo[nm] = el
        return el

    @staticmethod
    def wrap(nm):
        try:
            return jclass(nm)
        except Exception:
            if "$" in nm:
                outer_cls, nested = nm.split("$", 1)
                try:
                    target_obj = jclass(outer_cls)
                    for piece in nested.split("$"):
                        target_obj = getattr(target_obj, piece)
                    return target_obj
                except Exception:
                    return None
            return None


_API_LEVEL = [None]


def api_level():
    if _API_LEVEL[0] is None:
        try:
            _API_LEVEL[0] = int(jclass("android.os.Build$VERSION").SDK_INT)
        except Exception:
            try:
                from android.os import Build
                _API_LEVEL[0] = int(Build.VERSION.SDK_INT)
            except Exception:
                _API_LEVEL[0] = 0
    return _API_LEVEL[0]


def find_static(cls, nm, accept):
    try:
        fobj = cls.getDeclaredField(nm)
        fobj.setAccessible(True)
        return fobj
    except Exception:
        pass
    JModifier = jclass("java.lang.reflect.Modifier")
    for fobj in cls.getDeclaredFields():
        try:
            if JModifier.isStatic(fobj.getModifiers()) and accept(fobj):
                fobj.setAccessible(True)
                return fobj
        except Exception:
            pass
    raise RuntimeError("поле %s не найдено" % nm)


def cache_field_of(au_cls):
    map_type = Reflect.type_of("java.util.Map")
    return find_static(au_cls, "typefaceCache",
                       lambda fobj: map_type.isAssignableFrom(fobj.getType())
                       and "android.graphics.Typeface" in str(fobj.getGenericType()))


def medium_field_of(au_cls):
    return find_static(au_cls, "mediumTypeface",
                       lambda fobj: fobj.getType().getName() == TYPEFACE_CLS and "medium" in fobj.getName().lower())


def _context():
    try:
        return ApplicationLoader.applicationContext
    except Exception:
        return None


class FaceKit:
    def __init__(self, face_map, genuine, facts):
        self.faces = face_map
        self.genuine = set(genuine)
        self.details = facts
        self.by_face = {}
        for face in reversed(FACES):
            face_tf = face_map.get(face)
            if face_tf is not None:
                self.by_face[face_tf] = face


def assemble_kit(face_slots, medium_as_bold, facts=None):
    if "regular" not in face_slots:
        raise LoadError("Не выбран основной шрифт")
    TF = jclass(TYPEFACE_CLS)
    JFile = jclass("java.io.File")
    api = api_level()
    face_builder = Reflect.wrap("android.graphics.Typeface$Builder") if api >= 26 else None

    def open_face(fpath, heaviness, slanted, var_settings=None):
        face_tf = None
        if face_builder is not None:
            bx = face_builder(JFile(fpath))
            bx.setWeight(int(heaviness))
            bx.setItalic(bool(slanted))
            if var_settings:
                bx.setFontVariationSettings(var_settings)
            face_tf = bx.build()
        else:
            face_tf = TF.createFromFile(fpath)
        if face_tf is None:
            raise LoadError("Android не смог загрузить шрифт «%s»" % os.path.basename(fpath))
        return face_tf

    def wght_spec(axis_map, wt):
        return "'wght' %g" % _axis_clip(wt, axis_map["wght"])

    with _Bypass():
        genuine = {}
        for face in FACES:
            fslot = face_slots.get(face)
            if not fslot:
                continue
            axis_map = (fslot.get("info") or {}).get("axes") or {}
            var_spec = wght_spec(axis_map, FACE_WEIGHT[face]) if "wght" in axis_map and face_builder is not None else None
            genuine[face] = open_face(fslot["path"], FACE_WEIGHT[face], FACE_SLANTED[face], var_spec)

        reg_slot = face_slots["regular"]
        axis_map = (reg_slot.get("info") or {}).get("axes") or {}
        if face_builder is not None and axis_map:
            if "wght" in axis_map:
                for face in ("medium", "bold"):
                    if face not in genuine:
                        genuine[face] = open_face(reg_slot["path"], FACE_WEIGHT[face], False, wght_spec(axis_map, FACE_WEIGHT[face]))
            slant_var = None
            if "ital" in axis_map:
                slant_var = "'ital' %g" % _axis_clip(1, axis_map["ital"])
            elif "slnt" in axis_map and axis_map["slnt"][0] < 0:
                slant_var = "'slnt' %g" % max(axis_map["slnt"][0], -12)
            if slant_var:
                for face in ("italic", "medium_italic", "bold_italic"):
                    if face in genuine:
                        continue
                    wt = FACE_WEIGHT[face]
                    var_spec = slant_var + (", " + wght_spec(axis_map, wt) if "wght" in axis_map else "")
                    genuine[face] = open_face(reg_slot["path"], wt, True, var_spec)

        face_map = dict(genuine)
        regular_tf = face_map["regular"]

        def fake_style(anchor, style_n):
            try:
                face_tf = TF.create(anchor, style_n)
                return face_tf if face_tf is not None else anchor
            except Exception:
                return anchor

        if "bold" not in face_map:
            face_map["bold"] = fake_style(regular_tf, ST_BOLD)
        if "italic" not in face_map:
            face_map["italic"] = fake_style(regular_tf, ST_ITALIC)
        if "bold_italic" not in face_map:
            if "bold" in genuine:
                face_map["bold_italic"] = fake_style(genuine["bold"], ST_ITALIC)
            elif "italic" in genuine:
                face_map["bold_italic"] = fake_style(genuine["italic"], ST_BOLD)
            else:
                face_map["bold_italic"] = fake_style(regular_tf, ST_BOLD_ITALIC)
        if "medium" not in face_map:
            face_map["medium"] = face_map["bold"] if medium_as_bold else regular_tf
        if "medium_italic" not in face_map:
            if "medium" in genuine:
                face_map["medium_italic"] = fake_style(genuine["medium"], ST_ITALIC)
            else:
                face_map["medium_italic"] = face_map["bold_italic"] if medium_as_bold else face_map["italic"]
    return FaceKit(face_map, genuine.keys(), facts or {})


def _process_dict(nm):
    reg_slot = getattr(sys, nm, None)
    if not isinstance(reg_slot, dict):
        reg_slot = {}
        setattr(sys, nm, reg_slot)
    return reg_slot


class FaceRegistry:
    def __init__(self, owner):
        self.owner = owner
        self.kit = None
        self.stock = _process_dict("_nelyfonts_known")
        self.mine = _process_dict("_nelyfonts_ours")
        self.hold_mono = True
        self.hold_serif = False
        self._asset_memo = {}
        self.asset_keys = set(STOCK_ASSETS)

    def use_kit(self, kit):
        if kit is not None:
            for face_tf, face in kit.by_face.items():
                self.mine[face_tf] = face
        self.kit = kit

    def is_mine(self, face_tf):
        try:
            return face_tf is not None and face_tf in self.mine
        except Exception:
            return False

    def role_of(self, face_tf):
        if face_tf is None:
            return "regular"
        try:
            face = self.mine.get(face_tf)
            if face is None:
                face = self.stock.get(face_tf)
            return face
        except Exception:
            return None

    def resolve(self, raw_face):
        if not raw_face or raw_face == "special":
            return None
        if raw_face == "mono":
            return None if self.hold_mono else "regular"
        if raw_face.startswith("serif_"):
            return None if self.hold_serif else raw_face[6:]
        return raw_face if raw_face in FACES else None

    def asset_target(self, fpath):
        lookup_key = str(fpath) if fpath is not None else ""
        raw_face = self._asset_memo.get(lookup_key)
        if raw_face is None:
            raw_face = asset_face(lookup_key) or ""
            self._asset_memo[lookup_key] = raw_face
        return self.resolve(raw_face)

    def learn_system_faces(self):
        try:
            TF = jclass(TYPEFACE_CLS)
            with _Bypass():
                seed_pairs = [(TF.DEFAULT, "regular"), (TF.SANS_SERIF, "regular"),
                              (TF.DEFAULT_BOLD, "bold"), (TF.MONOSPACE, "mono"),
                              (TF.SERIF, "serif_regular")]
                for style_n in (ST_PLAIN, ST_BOLD, ST_ITALIC, ST_BOLD_ITALIC):
                    face = face_for_style(style_n)
                    seed_pairs.append((TF.defaultFromStyle(style_n), face))
                    seed_pairs.append((TF.create("sans-serif", style_n), face))
                seed_pairs.append((TF.create("sans-serif-medium", ST_PLAIN), "medium"))
            for face_tf, face in seed_pairs:
                if face_tf is not None and face_tf not in self.stock:
                    self.stock[face_tf] = face
        except Exception as ex:
            self.owner.note("capture originals: %s" % ex)

    def _remember(self, face_tf, raw_face):
        if face_tf is None or not raw_face or raw_face == "special":
            return 0
        if face_tf in self.mine or face_tf in self.stock:
            return 0
        self.stock[face_tf] = raw_face
        return 1

    def learn_app_faces(self):
        cnt = 0
        try:
            au_api = jclass(UTILS_CLS)
            probes = [(lookup_key, asset_face(lookup_key), lambda key_=lookup_key: au_api.getTypeface(key_))
                      for lookup_key in sorted(self.asset_keys)]
            probes += [("regular()", "regular", lambda: au_api.regular()),
                       ("bold()", "medium", lambda: au_api.bold())]
            for _tag, raw_face, invoke_fn in probes:
                try:
                    with _Bypass():
                        cnt += self._remember(invoke_fn(), raw_face)
                except Exception:
                    pass
        except Exception:
            pass
        try:
            au_cls = Reflect.type_of(UTILS_CLS)
            if au_cls is None:
                return cnt
            tf_cache = None
            try:
                tf_cache = cache_field_of(au_cls).get(None)
            except Exception:
                tf_cache = None
            if tf_cache is not None:
                iter_ = tf_cache.entrySet().iterator()
                while iter_.hasNext():
                    ex = iter_.next()
                    key_, vv = ex.getKey(), ex.getValue()
                    if key_ is not None:
                        self.asset_keys.add(str(key_))
                    raw_face = asset_face(str(key_)) if key_ is not None else None
                    if vv is not None and raw_face and raw_face != "special" and vv not in self.mine and vv not in self.stock:
                        self.stock[vv] = raw_face
                        cnt += 1
            try:
                medium_tf = jclass(UTILS_CLS).mediumTypeface
                if medium_tf is not None and medium_tf not in self.mine and medium_tf not in self.stock:
                    self.stock[medium_tf] = "medium"
                    cnt += 1
            except Exception:
                pass
        except Exception as ex:
            self.owner.note("snapshot cache: %s" % ex)
        return cnt

    def stock_face(self, face):
        try:
            with _Bypass():
                face_tf = jclass(UTILS_CLS).getTypeface(FACE_STOCK_ASSET.get(face, FACE_STOCK_ASSET["regular"]))
            if face_tf is not None and face_tf not in self.stock:
                self.stock[face_tf] = face
            return face_tf
        except Exception:
            return None


class _FaceHook(MethodHook):
    def __init__(self, owner):
        self.owner = owner
        self.registry = owner.registry

    def _kit_now(self):
        if _bypassed() or not self.owner.is_live():
            return None
        return self.registry.kit


class _AssetLoaderHook(_FaceHook):
    def before_hooked_method(self, call_info):
        kit = self._kit_now()
        if kit is None:
            return
        try:
            face = self.registry.asset_target(call_info.args[0])
            if face:
                call_info.setResult(kit.faces[face])
        except Exception:
            pass


class _FamilyNameHook(_FaceHook):
    def before_hooked_method(self, call_info):
        kit = self._kit_now()
        if kit is None:
            return
        try:
            source_kind = family_type_of(call_info.args[0])
            if source_kind is None:
                return
            face = self.registry.resolve(face_for_family(source_kind, _as_int(call_info.args[1])))
            if face:
                call_info.setResult(kit.faces[face])
        except Exception:
            pass


class _DerivedFaceHook(_FaceHook):
    def before_hooked_method(self, call_info):
        kit = self._kit_now()
        if kit is None:
            return
        try:
            raw_face = self.registry.role_of(call_info.args[0])
            if raw_face is None:
                return
            face = self.registry.resolve(derived_face(raw_face, _as_int(call_info.args[1])))
            if face:
                call_info.setResult(kit.faces[face])
        except Exception:
            pass


class _WeightedFaceHook(_FaceHook):
    def before_hooked_method(self, call_info):
        kit = self._kit_now()
        if kit is None:
            return
        try:
            raw_face = self.registry.role_of(call_info.args[0])
            if raw_face is None:
                return
            heaviness, slanted = _as_int(call_info.args[1], 400), bool(call_info.args[2])
            if raw_face == "special":
                return
            if raw_face == "mono":
                face = self.registry.resolve("mono")
            elif raw_face.startswith("serif_"):
                face = self.registry.resolve("serif_" + face_for_weight(heaviness, slanted))
            else:
                face = face_for_weight(heaviness, slanted)
            if face:
                call_info.setResult(kit.faces[face])
        except Exception:
            pass


class _StyleDefaultHook(_FaceHook):
    def before_hooked_method(self, call_info):
        kit = self._kit_now()
        if kit is None:
            return
        try:
            call_info.setResult(kit.faces[face_for_style(_as_int(call_info.args[0]))])
        except Exception:
            pass


def _swap_for(rg, kit, present_tf):
    face = rg.resolve(rg.role_of(present_tf))
    if not face:
        return None
    fresh = kit.faces.get(face)
    if fresh is None:
        return None
    try:
        if present_tf is not None and present_tf.equals(fresh):
            return None
    except Exception:
        pass
    return fresh


class _TextViewInitHook(_FaceHook):
    def after_hooked_method(self, call_info):
        kit = self._kit_now()
        if kit is None:
            return
        try:
            node = call_info.thisObject
            fresh = _swap_for(self.registry, kit, node.getTypeface())
            if fresh is not None:
                node.setTypeface(fresh)
        except Exception:
            pass


class _PaintHolderInitHook(_FaceHook):
    def after_hooked_method(self, call_info):
        kit = self._kit_now()
        if kit is None:
            return
        try:
            target_obj = call_info.thisObject
            fresh = _swap_for(self.registry, kit, target_obj.getPaint().getTypeface())
            if fresh is not None:
                target_obj.setTypeface(fresh)
        except Exception:
            pass


class _FaceArgumentHook(_FaceHook):
    def __init__(self, owner, face_index):
        super().__init__(owner)
        self.slot_no = face_index

    def before_hooked_method(self, call_info):
        kit = self._kit_now()
        if kit is None:
            return
        try:
            fresh = _swap_for(self.registry, kit, call_info.args[self.slot_no])
            if fresh is not None:
                call_info.args[self.slot_no] = fresh
        except Exception:
            pass


class _ExteraPaintInitHook(_FaceHook):
    def after_hooked_method(self, call_info):
        kit = self._kit_now()
        if kit is None:
            return
        try:
            paint_obj = call_info.thisObject
            fresh = _swap_for(self.registry, kit, paint_obj.getTypeface())
            if fresh is not None:
                paint_obj.setTypeface(fresh)
        except Exception:
            pass


class _PaintFaceSetterHook(MethodHook):
    def __init__(self, owner):
        self.owner = owner
        self.registry = owner.registry

    def before_hooked_method(self, call_info):
        rg = self.registry
        kit = rg.kit
        if kit is None or _bypassed() or not self.owner.is_live():
            return
        try:
            face_tf = call_info.args[0]
            if face_tf is None:
                return
            raw_face = rg.stock.get(face_tf)
            if raw_face is None:
                return
            face = rg.resolve(raw_face)
            if face:
                call_info.args[0] = kit.faces[face]
        except Exception:
            pass


class _CacheResetHook(_FaceHook):
    def after_hooked_method(self, call_info):
        kit = self._kit_now()
        if kit is None:
            return
        try:
            self.owner.fill_app_cache(kit)
        except Exception:
            pass


class _BarePaintInitHook(_FaceHook):
    def after_hooked_method(self, call_info):
        kit = self._kit_now()
        if kit is None:
            return
        try:
            paint_obj = call_info.thisObject
            if paint_obj.getTypeface() is None:
                paint_obj.setTypeface(kit.faces["regular"])
        except Exception:
            pass


def _picked_uris(blob):
    doc_uris = []
    if blob is None:
        return doc_uris
    try:
        clip_data = blob.getClipData()
        if clip_data is not None:
            for pos in range(clip_data.getItemCount()):
                uu = clip_data.getItemAt(pos).getUri()
                if uu is not None:
                    doc_uris.append(uu)
    except Exception:
        pass
    if not doc_uris:
        try:
            uu = blob.getData()
            if uu is not None:
                doc_uris.append(uu)
        except Exception:
            pass
    return doc_uris


class _PickerResultHook(MethodHook):
    def __init__(self, owner):
        self.owner = owner

    def before_hooked_method(self, call_info):
        if not self.owner.is_live():
            return
        try:
            shift = (_as_int(call_info.args[0]) & 0xFFFF) - PICK_CODE
            if shift < 0 or shift > len(FACES):
                return
            if _as_int(call_info.args[1]) != -1:
                return
            doc_uris = _picked_uris(call_info.args[2])
            fslot = None if shift == 0 else FACES[shift - 1]
            self.owner.handle_picked(doc_uris, fslot)
        except Exception:
            self.owner.note("activity result: %s" % traceback.format_exc())


class HookRegistry:
    def __init__(self, owner):
        self.owner = owner
        self.face_handles = []
        self.misc_handles = []
        self.state = {}
        self.picker_classes = set()

    def _attach(self, sink, caption, target_member, hook_obj):
        try:
            handle = self.owner.hook_method(target_member, hook_obj)
        except Exception as ex:
            self.state[caption] = "ошибка: %s" % ex
            self.owner.note("hook %s: %s" % (caption, ex))
            return 0
        if handle is not None:
            sink.append(handle)
        prior_count = self.state.get(caption)
        self.state[caption] = (prior_count if isinstance(prior_count, int) else 0) + 1
        return 1

    def _resolve_types(self, name_rows):
        param_types_ = []
        for type_name in name_rows:
            el = Reflect.type_of(type_name)
            if el is None:
                return None
            param_types_.append(el)
        return param_types_

    def _attach_methods(self, sink, caption, class_name, nm, hook_obj, type_names):
        el = Reflect.type_of(class_name)
        if el is None:
            self.state[caption] = "нет класса"
            return 0
        cnt = 0
        try:
            for mm in el.getDeclaredMethods():
                try:
                    if mm.getName() != nm or mm.isBridge():
                        continue
                    param_types_ = mm.getParameterTypes()
                    if len(param_types_) != len(type_names):
                        continue
                    if any(tt.getName() != px for tt, px in zip(param_types_, type_names)):
                        continue
                    cnt += self._attach(sink, caption, mm, hook_obj)
                except Exception:
                    pass
        except Exception as ex:
            self.state[caption] = "ошибка: %s" % ex
            return 0
        if cnt == 0 and caption not in self.state:
            self.state[caption] = "нет метода"
        return cnt

    def _attach_inits(self, sink, caption, class_name, hook_obj, type_names=None):
        el = Reflect.type_of(class_name)
        if el is None:
            self.state[caption] = "нет класса"
            return 0
        try:
            if type_names is None:
                inits = list(el.getDeclaredConstructors())
            else:
                param_types_ = self._resolve_types(type_names)
                if param_types_ is None:
                    self.state[caption] = "нет типа параметра"
                    return 0
                inits = [el.getDeclaredConstructor(*param_types_)]
        except Exception as ex:
            self.state[caption] = "нет конструктора"
            self.owner.note("ctor %s: %s" % (caption, ex))
            return 0
        return sum(self._attach(sink, caption, key_, hook_obj) for key_ in inits)

    def attach_face_hooks(self, prefs_map):
        self.detach_face_hooks()
        owner = self.owner
        bx = self.face_handles
        for lookup_key in list(self.state):
            if not lookup_key.startswith("onActivityResult"):
                del self.state[lookup_key]

        loader_hook = _AssetLoaderHook(owner)
        for class_name, method_name in ((UTILS_CLS, "getTypeface"),
                                        (EXTERA_FONTS_CLS, "getSystemTypeface"),
                                        (EXTERA_FONTS_CLS, "getFontFromAssets")):
            caption = "%s.%s" % (class_name.rsplit(".", 1)[-1], method_name)
            self._attach_methods(bx, caption, class_name, method_name, loader_hook, ("java.lang.String",))

        self._attach_methods(bx, "Typeface.create(String,int)", TYPEFACE_CLS, "create",
                             _FamilyNameHook(owner), ("java.lang.String", "int"))
        self._attach_methods(bx, "Typeface.create(Typeface,int)", TYPEFACE_CLS, "create",
                             _DerivedFaceHook(owner), (TYPEFACE_CLS, "int"))
        if api_level() >= 28:
            self._attach_methods(bx, "Typeface.create(Typeface,int,boolean)", TYPEFACE_CLS, "create",
                                 _WeightedFaceHook(owner), (TYPEFACE_CLS, "int", "boolean"))
        self._attach_methods(bx, "Typeface.defaultFromStyle", TYPEFACE_CLS, "defaultFromStyle",
                             _StyleDefaultHook(owner), ("int",))

        if prefs_map.get("hook_constructors", True):
            self._attach_inits(bx, "TextView.<init>", "android.widget.TextView", _TextViewInitHook(owner),
                               ("android.content.Context", "android.util.AttributeSet", "int", "int"))
            self._attach_inits(bx, "AnimatedTextDrawable.<init>",
                               "org.telegram.ui.Components.AnimatedTextView$AnimatedTextDrawable",
                               _PaintHolderInitHook(owner))
            self._attach_inits(bx, "Components.Text.<init>", "org.telegram.ui.Components.Text",
                               _FaceArgumentHook(owner, 2), ("java.lang.CharSequence", "float", TYPEFACE_CLS))
            self._attach_inits(bx, "SimpleTextView.<init>", "org.telegram.ui.ActionBar.SimpleTextView",
                               _PaintHolderInitHook(owner))
            self._attach_inits(bx, "TextPaint exteraGram.<init>", "com.exteragram.messenger.utils.ui.TextPaint",
                               _ExteraPaintInitHook(owner))

        self._attach_methods(bx, "AndroidUtilities.clearTypefaceCache", UTILS_CLS, "clearTypefaceCache",
                             _CacheResetHook(owner), ())

        if prefs_map.get("deep_mode", False):
            hook_inst = _BarePaintInitHook(owner)
            self._attach_inits(bx, "TextPaint()", "android.text.TextPaint", hook_inst, ())
            self._attach_inits(bx, "TextPaint(int)", "android.text.TextPaint", hook_inst, ("int",))
            self._attach_methods(bx, "Paint.setTypeface", "android.graphics.Paint", "setTypeface",
                                 _PaintFaceSetterHook(owner), (TYPEFACE_CLS,))
        acc = sum(vv for vv in self.state.values() if isinstance(vv, int))
        owner.log("font hooks installed: %d -> %s" % (acc, self.state))

    def detach_face_hooks(self):
        for uu in self.face_handles:
            try:
                self.owner.unhook_method(uu)
            except Exception:
                pass
        self.face_handles = []

    @property
    def has_face_hooks(self):
        return bool(self.face_handles)

    def watch_picker(self, from_cls):
        try:
            el = from_cls
            while el is not None:
                nm = el.getName()
                if nm in self.picker_classes:
                    return True
                for mm in el.getDeclaredMethods():
                    try:
                        if mm.getName() == "onActivityResult" and len(mm.getParameterTypes()) == 3:
                            mm.setAccessible(True)
                            caption = "onActivityResult (%s)" % nm.rsplit(".", 1)[-1]
                            if self._attach(self.misc_handles, caption, mm, _PickerResultHook(self.owner)):
                                self.picker_classes.add(nm)
                                return True
                    except Exception:
                        pass
                if nm in ("android.app.Activity", "java.lang.Object"):
                    break
                el = el.getSuperclass()
        except Exception as ex:
            self.owner.note("result hook: %s" % ex)
        return False

    def detach_all(self):
        self.detach_face_hooks()
        for uu in self.misc_handles:
            try:
                self.owner.unhook_method(uu)
            except Exception:
                pass
        self.misc_handles = []
        self.picker_classes = set()


class StaticPaintSwap:
    HOLDERS = ("org.telegram.ui.ActionBar.Theme",
               "org.telegram.ui.ArticleViewer",
               "org.telegram.ui.Components.LetterDrawable",
               "org.telegram.ui.Components.OtherDocumentPlaceholderDrawable",
               "org.telegram.ui.Components.GroupCreateSpan",
               "org.telegram.ui.Components.Reactions.ReactionsLayoutInBubble",
               "org.telegram.ui.ContentPreviewViewer",
               "org.telegram.ui.ActionBar.BottomSheetTabs")

    def __init__(self, owner):
        self.owner = owner
        self._field_list = None
        self._before = {}
        self.swapped = 0
        self.scanned = 0

    def _holder_fields(self):
        if self._field_list is not None:
            return self._field_list
        field_list = []
        paint_type = Reflect.type_of("android.graphics.Paint")
        try:
            JModifier = jclass("java.lang.reflect.Modifier")
        except Exception:
            JModifier = None
        if paint_type is None or JModifier is None:
            self._field_list = field_list
            return field_list
        for nm in self.HOLDERS:
            el = Reflect.type_of(nm)
            if el is None or paint_type is None:
                continue
            for fobj in el.getDeclaredFields():
                try:
                    if not JModifier.isStatic(fobj.getModifiers()):
                        continue
                    tt = fobj.getType()
                    arrayish = bool(tt.isArray())
                    target_type = tt.getComponentType() if arrayish else tt
                    if target_type is None or not paint_type.isAssignableFrom(target_type):
                        continue
                    fobj.setAccessible(True)
                    field_list.append((fobj, arrayish))
                except Exception:
                    pass
        self._field_list = field_list
        return field_list

    def _live_paints(self):
        field_list = self._holder_fields()
        if not field_list:
            return
        ArrayRef = jclass("java.lang.reflect.Array")
        for fobj, arrayish in field_list:
            try:
                new_value = fobj.get(None)
            except Exception:
                continue
            if new_value is None:
                continue
            if not arrayish:
                yield new_value
                continue
            try:
                for pos in range(ArrayRef.getLength(new_value)):
                    px = ArrayRef.get(new_value, pos)
                    if px is not None:
                        yield px
            except Exception:
                pass

    def swap_in(self, rg, kit):
        swapped_n = acc = 0
        for px in self._live_paints():
            acc += 1
            try:
                now_tf = px.getTypeface()
                fresh = _swap_for(rg, kit, now_tf)
                if fresh is None:
                    if now_tf is not None and rg.is_mine(now_tf):
                        swapped_n += 1
                    continue
                if px not in self._before:
                    self._before[px] = now_tf
                px.setTypeface(fresh)
                swapped_n += 1
            except Exception:
                pass
        self.swapped, self.scanned = swapped_n, acc
        return swapped_n

    def swap_out(self, rg):
        for px, before_tf in list(self._before.items()):
            try:
                now_tf = px.getTypeface()
                if now_tf is None or rg.is_mine(now_tf):
                    px.setTypeface(before_tf)
            except Exception:
                pass
        self._before.clear()
        stock_by_face = {}
        for px in self._live_paints():
            try:
                now_tf = px.getTypeface()
                if now_tf is None or not rg.is_mine(now_tf):
                    continue
                face = rg.mine.get(now_tf) or "regular"
                if face not in stock_by_face:
                    stock_by_face[face] = rg.stock_face(face)
                px.setTypeface(stock_by_face[face])
            except Exception:
                pass
        self.swapped = 0


class ViewTreeSwap:
    PAINT_VIEWS = ("org.telegram.ui.ActionBar.SimpleTextView",
                   "org.telegram.ui.Components.AnimatedTextView")
    MAX_NODES = 8000

    def __init__(self, owner):
        self.owner = owner
        self.swapped = 0

    def _window_roots(self):
        root_views = []
        try:
            launch_inst = jclass("org.telegram.ui.LaunchActivity").instance
            if launch_inst is not None:
                root_views.append(launch_inst.getWindow().getDecorView())
        except Exception:
            pass
        if not root_views:
            try:
                activity = self.owner._host_activity()
                if activity is not None:
                    root_views.append(activity.getWindow().getDecorView())
            except Exception:
                pass
        return root_views

    def traverse(self, handle_view):
        TextViewCls = Reflect.wrap("android.widget.TextView")
        ViewGroupCls = Reflect.wrap("android.view.ViewGroup")
        paint_view_types = [el for el in (Reflect.wrap(view_cls) for view_cls in self.PAINT_VIEWS) if el is not None]
        acc = visited = 0
        for root_view in self._window_roots():
            pending = [root_view]
            while pending and visited < self.MAX_NODES:
                vv = pending.pop()
                visited += 1
                try:
                    if TextViewCls is not None and isinstance(vv, TextViewCls):
                        acc += handle_view(vv, vv.getTypeface(), vv.setTypeface)
                    else:
                        for cls in paint_view_types:
                            if isinstance(vv, cls):
                                acc += handle_view(vv, vv.getPaint().getTypeface(), vv.setTypeface)
                                break
                    if ViewGroupCls is not None and isinstance(vv, ViewGroupCls):
                        for pos in range(vv.getChildCount()):
                            pending.append(vv.getChildAt(pos))
                except Exception:
                    pass
        return acc

    def swap_in(self, rg, kit):
        def handle_view(_node, face_tf, assign_fn):
            fresh = _swap_for(rg, kit, face_tf)
            if fresh is None:
                return 0
            assign_fn(fresh)
            return 1
        self.swapped = self.traverse(handle_view)
        return self.swapped

    def swap_out(self, rg):
        stock_by_face = {}

        def handle_view(_node, face_tf, assign_fn):
            if face_tf is None or not rg.is_mine(face_tf):
                return 0
            face = rg.mine.get(face_tf) or "regular"
            if face not in stock_by_face:
                stock_by_face[face] = rg.stock_face(face)
            assign_fn(stock_by_face[face])
            return 1
        self.traverse(handle_view)
        self.swapped = 0


class SystemDefaultSwap:
    def __init__(self, owner):
        self.owner = owner
        self._before = None
        self._active = False
        self.state = "не применялся"

    def _setter_method(self):
        typeface_type = Reflect.type_of(TYPEFACE_CLS)
        mm = typeface_type.getDeclaredMethod("setDefault", typeface_type)
        mm.setAccessible(True)
        return mm

    def swap_in(self, face_tf):
        try:
            if self._before is None:
                self._before = jclass(TYPEFACE_CLS).DEFAULT
            with _Bypass():
                self._setter_method().invoke(None, face_tf)
            self._active = True
            self.state = "применён"
        except Exception as ex:
            self.state = "недоступен (%s)" % ex.__class__.__name__

    def swap_out(self):
        if not self._active or self._before is None:
            return
        try:
            with _Bypass():
                self._setter_method().invoke(None, self._before)
        except Exception:
            pass
        self._active = False
        self.state = "восстановлен"


class FontVault:
    def __init__(self, root_view):
        self.folder = root_view
        self.manifest = None
        self.mutex = threading.RLock()

    @property
    def manifest_file(self):
        return os.path.join(self.folder, "meta.json")

    def file_at(self, stored_name):
        return os.path.join(self.folder, stored_name)

    def reload(self):
        manifest = None
        try:
            with open(self.manifest_file, "r", encoding="utf-8") as fobj:
                manifest = json.load(fobj)
            reg_slot = manifest.get("slots", {}).get("regular")
            if not reg_slot or not os.path.isfile(self.file_at(reg_slot["file"])):
                manifest = None
        except Exception:
            manifest = None
        self.manifest = manifest
        return manifest

    def face_files(self, manifest=None):
        manifest = manifest or self.manifest or {}
        sink_out = {}
        for face, fslot in (manifest.get("slots") or {}).items():
            px = self.file_at(fslot.get("file", ""))
            if face in FACES and os.path.isfile(px):
                sink_out[face] = {"path": px, "info": fslot}
        return sink_out

    def save_faces(self, picked_faces, full_swap, via, origin_text):
        with self.mutex:
            os.makedirs(self.folder, exist_ok=True)
            stamp_ms = int(time.time() * 1000)
            face_slots = {} if (full_swap or not self.manifest) else dict(self.manifest.get("slots") or {})
            for face, cnd in picked_faces.items():
                facts = dict(cnd["info"])
                suffix = ".otf" if facts.get("format", "").startswith("OpenType") else ".ttf"
                if facts.get("collection"):
                    suffix = ".ttc"
                # Всегда новое имя + os.replace: Android держит шрифт в mmap, перезапись на месте роняет приложение.
                stored_name = "%s-%d%s" % (face, stamp_ms, suffix)
                target_path = self.file_at(stored_name)
                part_path = target_path + ".part"
                shutil.copyfile(cnd["path"], part_path)
                os.replace(part_path, target_path)
                facts.update(file=stored_name, name=cnd.get("name", ""))
                face_slots[face] = facts
            reg_slot = face_slots.get("regular") or {}
            manifest = {
                "version": 1,
                "family": reg_slot.get("family") or "",
                "source": via,
                "origin": origin_text,
                "updated": int(time.time()),
                "slots": face_slots,
            }
            part_path = self.manifest_file + ".part"
            with open(part_path, "w", encoding="utf-8") as fobj:
                json.dump(manifest, fobj, ensure_ascii=False, indent=1)
            os.replace(part_path, self.manifest_file)
            self.manifest = manifest
            self._prune()
            return manifest

    def drop_face(self, face):
        with self.mutex:
            if not self.manifest or face == "regular" or face not in self.manifest.get("slots", {}):
                return False
            manifest = dict(self.manifest)
            manifest["slots"] = dict(manifest["slots"])
            del manifest["slots"][face]
            part_path = self.manifest_file + ".part"
            with open(part_path, "w", encoding="utf-8") as fobj:
                json.dump(manifest, fobj, ensure_ascii=False, indent=1)
            os.replace(part_path, self.manifest_file)
            self.manifest = manifest
            self._prune()
            return True

    def wipe(self):
        with self.mutex:
            self.manifest = None
            try:
                os.remove(self.manifest_file)
            except Exception:
                pass
            self._prune()

    def _prune(self):
        retain = {"meta.json"}
        for fslot in ((self.manifest or {}).get("slots") or {}).values():
            retain.add(fslot.get("file"))
        try:
            for nm in os.listdir(self.folder):
                if nm not in retain:
                    try:
                        os.remove(os.path.join(self.folder, nm))
                    except Exception:
                        pass
        except Exception:
            pass


class NelyFonts(BasePlugin):
    TOGGLES = {
        "keep_monospace": True,
        "keep_serif": False,
        "medium_as_bold": True,
        "hook_constructors": True,
        "deep_mode": False,
    }

    def on_plugin_load(self):
        self._mark = object()
        setattr(sys, INSTANCE_SLOT, self._mark)
        self._journal = deque(maxlen=80)
        self._intake_lock = threading.Lock()
        self._build_lock = threading.RLock()
        self._recent_pick = (None, 0.0)
        self._button_cls = None
        self._listing_memo = {}
        self.kit_ready = None
        self.registry = FaceRegistry(self)
        self.hookset = HookRegistry(self)
        self.paint_swap = StaticPaintSwap(self)
        self.view_swap = ViewTreeSwap(self)
        self.cached_count = 0
        self.cache_check = "не проверялся"
        self.default_swap = SystemDefaultSwap(self)
        self.prefs = {}
        try:
            self._load_prefs()
            self.vault = FontVault(self._vault_dir())
            self.vault.reload()
            self.registry.learn_system_faces()
            launch_cls = Reflect.type_of("org.telegram.ui.LaunchActivity")
            if launch_cls is not None:
                self.hookset.watch_picker(launch_cls)
        except Exception:
            self.note("load: %s" % traceback.format_exc())
            if not hasattr(self, "vault"):
                self.vault = FontVault(self._vault_dir())
        threading.Thread(target=self._startup, name="NelyFonts-boot", daemon=True).start()
        self.log("NelyFonts %s loaded" % __version__)

    def _startup(self):
        try:
            if not self.is_live():
                return
            if self._flag("enabled", True) and self.vault.manifest:
                self._enable_saved(notice=None)
        except Exception:
            self.note("boot: %s" % traceback.format_exc())

    def on_plugin_unload(self):
        try:
            if self.is_live():
                setattr(sys, INSTANCE_SLOT, None)
            rg, hook_reg, pswap, assign_fn = self.registry, self.hookset, self.paint_swap, self.default_swap
            rg.use_kit(None)
            hook_reg.detach_all()

            def on_main():
                for func in (self._flush_app_cache, lambda: pswap.swap_out(rg),
                             lambda: self.view_swap.swap_out(rg), assign_fn.swap_out, self._redraw_fragments):
                    try:
                        func()
                    except Exception:
                        pass
            run_on_ui_thread(on_main)
            self.log("NelyFonts unloaded")
        except Exception:
            self.log("unload error: %s" % traceback.format_exc())

    def is_live(self):
        return getattr(sys, INSTANCE_SLOT, None) is getattr(self, "_mark", None)

    def note(self, line_text):
        log_line = "%s %s" % (time.strftime("%H:%M:%S"), line_text)
        try:
            self._journal.append(log_line)
        except Exception:
            pass
        try:
            self.log(log_line)
        except Exception:
            pass

    def _flag(self, lookup_key, fallback):
        try:
            vv = self.get_setting(lookup_key, fallback)
            if isinstance(vv, str):
                return vv.strip().lower() in ("1", "true", "yes", "on")
            return bool(vv)
        except Exception:
            return fallback

    def _load_prefs(self):
        self.prefs = {key_: self._flag(key_, dv) for key_, dv in self.TOGGLES.items()}
        self.registry.hold_mono = self.prefs["keep_monospace"]
        self.registry.hold_serif = self.prefs["keep_serif"]

    def _vault_dir(self):
        try:
            return os.path.join(str(_context().getFilesDir().getAbsolutePath()), STORE_FOLDER)
        except Exception:
            return os.path.join(os.getcwd(), STORE_FOLDER)

    def _scratch_dir(self):
        try:
            return os.path.join(str(_context().getCacheDir().getAbsolutePath()), SCRATCH_FOLDER)
        except Exception:
            return os.path.join(os.getcwd(), SCRATCH_FOLDER)

    def _top_fragment(self):
        fragment_ref = None
        if get_last_fragment is not None:
            try:
                fragment_ref = get_last_fragment()
            except Exception:
                fragment_ref = None
        if fragment_ref is None:
            try:
                fragment_ref = jclass("org.telegram.ui.LaunchActivity").getLastFragment()
            except Exception:
                fragment_ref = None
        return fragment_ref

    def _host_activity(self):
        fragment_ref = self._top_fragment()
        try:
            activity = fragment_ref.getParentActivity() if fragment_ref is not None else None
        except Exception:
            activity = None
        if activity is None:
            try:
                activity = jclass("org.telegram.ui.LaunchActivity").instance
            except Exception:
                activity = None
        return activity

    def _bulletin(self, source_kind, text_msg):
        if BulletinHelper is None or not text_msg:
            return

        def present():
            try:
                getattr(BulletinHelper, "show_" + source_kind)(text_msg)
            except Exception:
                pass
        run_on_ui_thread(present)

    def say_ok(self, text_msg):
        self._bulletin("success", text_msg)

    def say_error(self, text_msg):
        self._bulletin("error", text_msg)

    def say_info(self, text_msg):
        self._bulletin("info", text_msg)

    def _reload_settings_page(self):
        try:
            self.set_setting("_rev", int(time.time() * 1000) % 1000000, reload_settings=True)
        except TypeError:
            pass
        except Exception:
            pass

    def _enable_saved(self, notice="Шрифт применён"):
        with self._build_lock:
            manifest = self.vault.manifest
            if not manifest:
                return False
            face_slots = self.vault.face_files(manifest)
            kit = assemble_kit(face_slots, self.prefs.get("medium_as_bold", True), manifest)
            self.kit_ready = kit
        self._engage(kit, notice)
        return True

    def _enable_saved_async(self, notice="Шрифт применён"):
        def in_background():
            try:
                if not self._enable_saved(notice):
                    self.say_info("Сначала выберите шрифт")
            except LoadError as ex:
                self.say_error(str(ex))
            except Exception:
                self.note("apply: %s" % traceback.format_exc())
                self.say_error("Не удалось применить шрифт — подробности в отчёте")
        threading.Thread(target=in_background, name="NelyFonts-apply", daemon=True).start()

    def _try_step(self, nm, func):
        try:
            func()
            return True
        except Exception:
            self.note("%s: %s" % (nm, traceback.format_exc()))
            return False

    def _engage(self, kit, notice):
        rg, hook_reg, pswap, run_step = self.registry, self.hookset, self.paint_swap, self._try_step

        def on_main():
            if not self.is_live():
                return
            rg.use_kit(None)
            run_step("snapshot", rg.learn_app_faces)
            run_step("clear cache", self._flush_app_cache)
            run_step("restore paints", lambda: pswap.swap_out(rg))
            hooks_ok = run_step("install hooks", lambda: hook_reg.attach_face_hooks(self.prefs))
            rg.use_kit(kit)
            run_step("prime cache", lambda: self.fill_app_cache(kit))
            run_step("verify cache", lambda: self.check_app_cache(kit))
            run_step("patch paints", lambda: pswap.swap_in(rg, kit))
            run_step("set default", lambda: self.default_swap.swap_in(kit.faces["regular"]))
            run_step("rebuild", self._redraw_fragments)
            run_step("patch views", lambda: self.view_swap.swap_in(rg, kit))
            self._after(lambda: self._sweep_views_again(kit), 600)
            if not hooks_ok:
                self.say_error("Шрифт применён частично — подробности в отчёте")
            elif notice:
                self.say_ok(notice)
            if notice:
                self._reload_settings_page()
        run_on_ui_thread(on_main)

    def _disengage(self, notice=None):
        rg, hook_reg, pswap, run_step = self.registry, self.hookset, self.paint_swap, self._try_step

        def on_main():
            rg.use_kit(None)
            run_step("snapshot", rg.learn_app_faces)
            run_step("uninstall hooks", hook_reg.detach_face_hooks)
            # Кеш чистится до отката, иначе «штатные» гарнитуры придут из него нашими.
            run_step("clear cache", self._flush_app_cache)
            run_step("restore paints", lambda: pswap.swap_out(rg))
            run_step("restore views", lambda: self.view_swap.swap_out(rg))
            run_step("restore default", self.default_swap.swap_out)
            run_step("rebuild", self._redraw_fragments)
            if notice:
                self.say_ok(notice)
                self._reload_settings_page()
        run_on_ui_thread(on_main)

    def _flush_app_cache(self):
        try:
            with _Bypass():
                jclass(UTILS_CLS).clearTypefaceCache()
            return
        except Exception:
            pass
        try:
            au_cls = Reflect.type_of(UTILS_CLS)
            fobj = au_cls.getDeclaredField("typefaceCache")
            fobj.setAccessible(True)
            fobj.get(None).clear()
            mm = au_cls.getDeclaredField("mediumTypeface")
            mm.setAccessible(True)
            mm.set(None, None)
        except Exception as ex:
            self.note("clear cache: %s" % ex)

    # regular()/bold()/getTypeface() — короткие методы: ART встраивает их в места вызова, и хук
    # их не видит. Но кеш они читают всегда, поэтому наш шрифт кладётся прямо в него.
    def fill_app_cache(self, kit):
        au_cls = Reflect.type_of(UTILS_CLS)
        if au_cls is None:
            raise RuntimeError("AndroidUtilities не найден")
        tf_cache = cache_field_of(au_cls).get(None)
        cnt = 0
        for lookup_key in sorted(self.registry.asset_keys):
            face = self.registry.asset_target(lookup_key)
            try:
                if face:
                    tf_cache.put(lookup_key, kit.faces[face])
                    cnt += 1
                else:
                    now_tf = tf_cache.get(lookup_key)
                    if now_tf is not None and self.registry.is_mine(now_tf):
                        tf_cache.remove(lookup_key)
            except Exception:
                pass
        try:
            medium_field_of(au_cls).set(None, kit.faces["medium"])
        except Exception as ex:
            self.note("prime medium: %s" % ex)
        self.cached_count = cnt
        return cnt

    def check_app_cache(self, kit):
        rg = self.registry
        au_api = jclass(UTILS_CLS)
        still_stock = []
        probes = [(lookup_key, lambda key_=lookup_key: au_api.getTypeface(key_)) for lookup_key in sorted(rg.asset_keys)]
        probes += [("regular()", lambda: au_api.regular()), ("bold()", lambda: au_api.bold())]
        for caption, invoke_fn in probes:
            raw_face = "regular" if caption == "regular()" else ("medium" if caption == "bold()" else asset_face(caption))
            if not rg.resolve(raw_face):
                continue
            try:
                face_tf = invoke_fn()
            except Exception:
                continue
            if face_tf is not None and not rg.is_mine(face_tf):
                if face_tf not in rg.stock:
                    rg.stock[face_tf] = raw_face
                still_stock.append(caption)
        self.cache_check = "наш шрифт" if not still_stock else "штатный: " + ", ".join(still_stock)
        if still_stock:
            self.note("cache verify: %s" % self.cache_check)
        return not still_stock

    def _after(self, func, wait_ms):
        try:
            run_on_ui_thread(func, wait_ms)
        except TypeError:
            threading.Timer(wait_ms / 1000.0, lambda: run_on_ui_thread(func)).start()
        except Exception:
            pass

    def _sweep_views_again(self, kit):
        if self.is_live() and self.registry.kit is kit:
            self._try_step("patch views (late)", lambda: self.view_swap.swap_in(self.registry, kit))

    def _redraw_fragments(self):
        try:
            launch_inst = jclass("org.telegram.ui.LaunchActivity").instance
            if launch_inst is not None:
                launch_inst.rebuildAllFragments(True)
        except Exception as ex:
            self.note("rebuild: %s" % ex)

    def _open_picker(self, fslot=None):
        def on_main():
            activity = self._host_activity()
            if activity is None:
                self.say_error("Не удалось открыть выбор файла")
                return
            try:
                self.hookset.watch_picker(activity.getClass())
            except Exception:
                pass
            JIntent = jclass("android.content.Intent")
            num_code = PICK_CODE + (FACES.index(fslot) + 1 if fslot else 0)
            last_err = None
            for act_name in (JIntent.ACTION_OPEN_DOCUMENT, JIntent.ACTION_GET_CONTENT):
                try:
                    pick_intent = JIntent(act_name)
                    pick_intent.addCategory(JIntent.CATEGORY_OPENABLE)
                    pick_intent.setType("*/*")
                    pick_intent.addFlags(JIntent.FLAG_GRANT_READ_URI_PERMISSION)
                    if fslot is None:
                        try:
                            pick_intent.putExtra(JIntent.EXTRA_ALLOW_MULTIPLE, True)
                        except Exception:
                            pass
                    activity.startActivityForResult(pick_intent, num_code)
                    return
                except Exception as ex:
                    last_err = ex
            self.note("picker: %s" % last_err)
            self.say_error("Не удалось открыть выбор файла")
        run_on_ui_thread(on_main)

    def handle_picked(self, doc_uris, fslot):
        if not doc_uris:
            self.say_error("Файл не выбран")
            return
        lookup_key = (fslot, tuple(str(uu) for uu in doc_uris))
        moment = time.time()
        if self._recent_pick[0] == lookup_key and moment - self._recent_pick[1] < 3.0:
            return
        self._recent_pick = (lookup_key, moment)
        self.intake_async([("uri", uu) for uu in doc_uris], fslot=fslot, via="file")

    def intake_async(self, inputs, fslot=None, via="file", quiet=False):
        def in_background():
            self._intake(inputs, fslot, via, quiet)
        threading.Thread(target=in_background, name="NelyFonts-import", daemon=True).start()

    def _intake(self, inputs, fslot, via, quiet=False):
        if not self._intake_lock.acquire(False):
            if not quiet:
                self.say_info("Импорт уже идёт, подождите")
            return False
        work_dir = os.path.join(self._scratch_dir(), str(int(time.time() * 1000)))
        try:
            if not quiet:
                self.say_info("Импорт шрифта…")
            os.makedirs(work_dir, exist_ok=True)
            fetched = []
            for pos, (source_kind, new_value) in enumerate(inputs):
                per_source_dir = os.path.join(work_dir, "s%02d" % pos)
                os.makedirs(per_source_dir, exist_ok=True)
                fetched.append(self._grab(source_kind, new_value, per_source_dir))
            found_fonts, problems = self._unpack(fetched)
            if not found_fonts:
                raise LoadError(problems[0] if problems else "Не найдено ни одного шрифта")
            if fslot:
                if fslot != "regular" and not self.vault.manifest:
                    raise LoadError("Сначала выберите основной шрифт")
                same_slant = [el for el in found_fonts if bool(el["info"].get("italic")) == FACE_SLANTED[fslot]] or found_fonts
                picked_faces = {fslot: min(same_slant, key=lambda el: abs(el["info"].get("weight", 400) - FACE_WEIGHT[fslot]))}
                full_swap = False
            elif len(found_fonts) == 1:
                picked_faces = {"regular": found_fonts[0]}
                full_swap = True
            else:
                picked_faces = spread_family(found_fonts)
                full_swap = True

            combined = {} if full_swap else self.vault.face_files()
            for face, cnd in picked_faces.items():
                combined[face] = {"path": cnd["path"], "info": cnd["info"]}
            assemble_kit(combined, self.prefs.get("medium_as_bold", True))

            origin_text = ", ".join(el.get("name", "") for el in picked_faces.values())
            manifest = self.vault.save_faces(picked_faces, full_swap, via, origin_text)
            try:
                self.set_setting("enabled", True)
            except Exception:
                pass
            fam_name = manifest.get("family") or "шрифт"
            face_words = [FACE_LABEL_SHORT[face_r] for face_r in FACES if face_r in picked_faces]
            text_msg = "«%s» применён" % fam_name
            if len(picked_faces) > 1:
                text_msg += " (%s)" % ", ".join(face_words)
            elif fslot and fslot != "regular":
                text_msg = "Начертание «%s» добавлено" % FACE_LABEL[fslot]
            if problems and not quiet:
                self.note("import warnings: %s" % "; ".join(problems))
            self._enable_saved(None if quiet else text_msg)
            return True
        except LoadError as ex:
            self.note("import: %s" % ex)
            if not quiet:
                self.say_error(str(ex))
        except Exception:
            self.note("import: %s" % traceback.format_exc())
            if not quiet:
                self.say_error("Ошибка импорта — подробности в «Скопировать отчёт»")
        finally:
            try:
                shutil.rmtree(work_dir, ignore_errors=True)
            except Exception:
                pass
            self._intake_lock.release()
        return False

    def _grab(self, source_kind, new_value, work_dir):
        if source_kind == "uri":
            return self._grab_uri(new_value, work_dir)
        if source_kind == "url":
            try:
                return self._grab_url(str(new_value), work_dir)
            except LoadError:
                raise
            except Exception as ex:
                raise LoadError("Не удалось скачать файл: %s" % (str(ex) or ex.__class__.__name__)[:120])
        if source_kind == "path":
            src_path = str(new_value)
            if not os.path.isfile(src_path):
                raise LoadError("Файл не найден: %s" % os.path.basename(src_path))
            if os.path.getsize(src_path) > SIZE_LIMIT:
                raise LoadError("Файл слишком большой (больше %s)" % human_size(SIZE_LIMIT))
            target_path = os.path.join(work_dir, clean_filename(os.path.basename(src_path)))
            try:
                shutil.copyfile(src_path, target_path)
            except PermissionError:
                raise LoadError("Нет доступа к файлу — выберите его через «Выбрать файлы шрифта»")
            return target_path, os.path.basename(src_path)
        raise LoadError("Неизвестный источник")

    def _grab_uri(self, doc_uri, work_dir):
        context = _context()
        if isinstance(doc_uri, str):
            doc_uri = jclass("android.net.Uri").parse(doc_uri)
        resolver = context.getContentResolver()
        nm = ""
        try:
            rows_cursor = resolver.query(doc_uri, None, None, None, None)
            if rows_cursor is not None:
                try:
                    if rows_cursor.moveToFirst():
                        col_idx = rows_cursor.getColumnIndex("_display_name")
                        if col_idx >= 0:
                            nm = rows_cursor.getString(col_idx) or ""
                finally:
                    rows_cursor.close()
        except Exception:
            pass
        if not nm:
            try:
                nm = unquote(str(doc_uri.getLastPathSegment() or "")).rsplit("/", 1)[-1]
            except Exception:
                nm = ""
        nm = nm or "font"
        try:
            in_stream = resolver.openInputStream(doc_uri)
        except Exception as ex:
            raise LoadError("Не удалось открыть файл: %s" % ex.__class__.__name__)
        if in_stream is None:
            raise LoadError("Не удалось открыть файл")
        target_path = os.path.join(work_dir, clean_filename(nm))
        self._drain_stream(in_stream, target_path)
        return target_path, nm

    def _drain_stream(self, in_stream, target_path):
        # Только настоящий Java byte[]: bytearray Chaquopy передаёт в read() копией, и на диск уходят нули.
        try:
            chunk_buf = jarray(jbyte)(65536)
        except Exception:
            chunk_buf = jarray(jbyte)(bytes(65536))
        part_path = target_path + ".part"
        sink_out = jclass("java.io.FileOutputStream")(part_path)
        acc = 0
        try:
            while True:
                cnt = _as_int(in_stream.read(chunk_buf), -1)
                if cnt < 0:
                    break
                if cnt == 0:
                    continue
                acc += cnt
                if acc > SIZE_LIMIT:
                    raise LoadError("Файл слишком большой (больше %s)" % human_size(SIZE_LIMIT))
                sink_out.write(chunk_buf, 0, cnt)
        finally:
            try:
                sink_out.close()
            except Exception:
                pass
            try:
                in_stream.close()
            except Exception:
                pass
        if acc <= 0:
            try:
                os.remove(part_path)
            except Exception:
                pass
            raise LoadError("Файл пустой")
        os.replace(part_path, target_path)
        return acc

    def _grab_url(self, link, work_dir):
        JUrl = jclass("java.net.URL")
        http = None
        for _ in range(6):
            http = JUrl(link).openConnection()
            http.setConnectTimeout(15000)
            http.setReadTimeout(30000)
            http.setInstanceFollowRedirects(True)
            http.setRequestProperty("User-Agent", "NelyFonts/%s (exteraGram plugin)" % __version__)
            num_code = _as_int(http.getResponseCode())
            if num_code in (301, 302, 303, 307, 308):
                location = http.getHeaderField("Location")
                http.disconnect()
                if not location:
                    break
                link = str(JUrl(JUrl(link), location).toString())
                continue
            break
        if num_code == 404:
            raise LoadError("По ссылке ничего нет (404)")
        if num_code != 200:
            raise LoadError("Сервер ответил кодом %d" % num_code)
        nm = link_filename(link)
        try:
            disp = http.getHeaderField("Content-Disposition") or ""
            mm = re.search(r"filename\*?=(?:UTF-8'')?\"?([^\";]+)", str(disp), re.I)
            if mm:
                nm = unquote(mm.group(1))
        except Exception:
            pass
        target_path = os.path.join(work_dir, clean_filename(nm))
        try:
            self._drain_stream(http.getInputStream(), target_path)
        finally:
            try:
                http.disconnect()
            except Exception:
                pass
        return target_path, nm

    def _unpack(self, fetched):
        found_fonts, problems = [], []
        for fpath, nm in fetched:
            try:
                with open(fpath, "rb") as fobj:
                    head_bytes = fobj.read(8)
                source_kind = detect_container(head_bytes)
                if source_kind == "font":
                    found_fonts.append(self._font_entry(fpath, nm))
                elif source_kind == "zip":
                    hits = self._unzip_fonts(fpath, os.path.dirname(fpath), nm, problems)
                    if not hits:
                        problems.append("В архиве «%s» нет файлов .ttf/.otf" % nm)
                    found_fonts.extend(hits)
                elif source_kind == "woff":
                    problems.append("«%s» — это WOFF/WOFF2 (веб-шрифт). Android его не поддерживает: "
                                    "скачайте версию TTF/OTF" % nm)
                elif source_kind == "html":
                    problems.append("По ссылке открылась веб-страница, а не файл шрифта. "
                                    "Нужна прямая ссылка на .ttf/.otf/.zip")
                else:
                    problems.append("«%s» не похож на файл шрифта (нужен TTF, OTF, TTC или ZIP)" % nm)
            except BadFontFile as ex:
                problems.append("Шрифт «%s» повреждён: %s" % (nm, ex))
            except LoadError as ex:
                problems.append(str(ex))
            except Exception as ex:
                problems.append("Не удалось прочитать «%s»: %s" % (nm, ex))
        return found_fonts, problems

    @staticmethod
    def _font_entry(fpath, nm):
        with open(fpath, "rb") as fobj:
            blob = fobj.read()
        return {"path": fpath, "name": nm, "info": inspect_font(blob, nm)}

    def _unzip_fonts(self, fpath, work_dir, nm, problems):
        hits = []
        try:
            archive = zipfile.ZipFile(fpath)
        except Exception:
            raise LoadError("Архив «%s» повреждён" % nm)
        with archive:
            zip_items = [pos for pos in archive.infolist()
                         if not pos.is_dir()
                         and pos.filename.lower().endswith(FONT_SUFFIXES)
                         and "__macosx" not in pos.filename.lower()
                         and not os.path.basename(pos.filename).startswith("._")]
            for col_idx, zip_item in enumerate(zip_items[:48]):
                anchor = os.path.basename(zip_item.filename)
                if zip_item.file_size > SIZE_LIMIT:
                    problems.append("«%s» слишком большой" % anchor)
                    continue
                target_path = os.path.join(work_dir, "z%02d_%s" % (col_idx, clean_filename(anchor)))
                try:
                    with archive.open(zip_item) as src_path, open(target_path, "wb") as sink_out:
                        shutil.copyfileobj(src_path, sink_out)
                    hits.append(self._font_entry(target_path, anchor))
                except BadFontFile as ex:
                    problems.append("Шрифт «%s» повреждён: %s" % (anchor, ex))
                except Exception as ex:
                    problems.append("Не удалось распаковать «%s»: %s" % (anchor, ex))
        return hits

    def _telegram_dirs(self):
        dir_list = []
        try:
            TgFiles = jclass("org.telegram.messenger.FileLoader")
            for tt in (3, 5, 4):
                try:
                    dv = TgFiles.getDirectory(tt)
                    if dv is not None:
                        dir_list.append(str(dv.getAbsolutePath()))
                except Exception:
                    pass
        except Exception:
            pass
        try:
            Environ = jclass("android.os.Environment")
            dl_dir = str(Environ.getExternalStoragePublicDirectory(Environ.DIRECTORY_DOWNLOADS).getAbsolutePath())
            dir_list += [dl_dir, os.path.join(dl_dir, "Telegram"), os.path.join(dl_dir, "Telegram", "Telegram Files")]
            docs_dir = str(Environ.getExternalStoragePublicDirectory(Environ.DIRECTORY_DOCUMENTS).getAbsolutePath())
            dir_list.append(docs_dir)
        except Exception:
            pass
        visited, sink_out = set(), []
        for dv in dir_list:
            if dv and dv not in visited:
                visited.add(dv)
                sink_out.append(dv)
        return sink_out

    def list_downloaded(self, max_items=40):
        hits = []
        for dv in self._telegram_dirs():
            try:
                with os.scandir(dv) as iter_:
                    for ex in iter_:
                        try:
                            if not ex.is_file():
                                continue
                            lowered = ex.name.lower()
                            font_file = lowered.endswith(FONT_SUFFIXES)
                            if not font_file and not lowered.endswith(".zip"):
                                continue
                            stat_res = ex.stat()
                            hits.append((stat_res.st_mtime, ex.path, ex.name, stat_res.st_size, font_file))
                        except Exception:
                            pass
            except Exception:
                pass
        hits.sort(reverse=True)
        sink_out = []
        for modified, fpath, nm, byte_size, font_file in hits:
            if len(sink_out) >= max_items:
                break
            caption = self._file_label(fpath, nm, byte_size, modified, font_file)
            if caption:
                sink_out.append((fpath, caption))
        return sink_out

    def _file_label(self, fpath, nm, byte_size, modified, font_file):
        lookup_key = (fpath, byte_size, modified)
        if lookup_key in self._listing_memo:
            return self._listing_memo[lookup_key]
        caption = None
        try:
            if font_file:
                fam_name = ""
                if byte_size <= 3 * 1024 * 1024:
                    with open(fpath, "rb") as fobj:
                        fam_name = inspect_font(fobj.read(), nm).get("family", "")
                caption = "%s — %s, %s" % (fam_name or nm, nm, human_size(byte_size)) if fam_name else "%s, %s" % (nm, human_size(byte_size))
            else:
                with zipfile.ZipFile(fpath) as archive:
                    n_items = sum(1 for entry_name in archive.namelist() if entry_name.lower().endswith(FONT_SUFFIXES) and "__macosx" not in entry_name.lower())
                if n_items:
                    caption = "%s — архив, шрифтов: %d" % (nm, n_items)
        except Exception:
            caption = None if not font_file else "%s, %s (не читается)" % (nm, human_size(byte_size))
        self._listing_memo[lookup_key] = caption
        return caption

    def _install_bundled(self):
        self.intake_async([("url", BUNDLED_LINK)], via="preset")

    def _link_changed(self, new_value):
        link_timer = getattr(self, "_link_timer", None)
        if link_timer is not None:
            link_timer.cancel()
        source_kind, norm_val = parse_link(new_value)
        if not source_kind or (source_kind == "url" and "." not in norm_val.split("://", 1)[-1]):
            return

        def fire():
            self.intake_async([(source_kind, norm_val)], via="link")
        self._link_timer = threading.Timer(1.2, fire)
        self._link_timer.daemon = True
        self._link_timer.start()

    def _enabled_changed(self, new_value):
        if new_value:
            if self.vault.manifest:
                self._enable_saved_async("Шрифт включён")
            else:
                self.say_info("Теперь выберите файл шрифта")
        else:
            self._disengage("Возвращён стандартный шрифт")

    def _pref_changed(self, lookup_key, new_value):
        self.prefs[lookup_key] = bool(new_value)
        self.registry.hold_mono = self.prefs.get("keep_monospace", True)
        self.registry.hold_serif = self.prefs.get("keep_serif", False)
        if self._flag("enabled", True) and self.vault.manifest:
            self._enable_saved_async("Настройки применены")

    def _drop_face(self, face):
        if self.vault.drop_face(face):
            self._enable_saved_async("Начертание «%s» убрано" % FACE_LABEL[face])

    def _forget_font(self):
        def in_background():
            self.vault.wipe()
            self.kit_ready = None
            self._disengage("Шрифт удалён, возвращён стандартный")
        threading.Thread(target=in_background, daemon=True).start()

    def _relaunch(self):
        def on_main():
            try:
                jclass("com.radolyn.ayugram.utils.AyuUtils").restartApplication()
                return
            except Exception:
                pass
            try:
                context = self._host_activity() or _context()
                pick_intent = context.getPackageManager().getLaunchIntentForPackage(context.getPackageName())
                JIntent = jclass("android.content.Intent")
                context.startActivity(JIntent.makeRestartActivityTask(pick_intent.getComponent()))
                jclass("java.lang.System").exit(0)
            except Exception as ex:
                self.note("restart: %s" % ex)
                self.say_error("Не удалось перезапустить — закройте приложение вручную")
        run_on_ui_thread(on_main)

    def _ask(self, dlg_title, notice, confirm_text, act_name):
        def on_main():
            fragment_ref = self._top_fragment()
            if fragment_ref is None:
                act_name()
                return
            try:
                if self._button_cls is None:
                    listener_iface = Reflect.wrap("org.telegram.ui.ActionBar.AlertDialog$OnButtonClickListener")

                    class _DialogButton(dynamic_proxy(listener_iface)):
                        def __init__(self, func):
                            super().__init__()
                            self.callback = func

                        def onClick(self, dlg, which_btn):
                            try:
                                self.callback()
                            except Exception:
                                pass
                    self._button_cls = _DialogButton
                DialogBuilder = Reflect.wrap("org.telegram.ui.ActionBar.AlertDialog$Builder")
                context = fragment_ref.getParentActivity() or fragment_ref.getContext()
                bx = DialogBuilder(context)
                bx.setTitle(dlg_title)
                bx.setMessage(notice)
                bx.setPositiveButton(confirm_text, self._button_cls(act_name))
                bx.setNegativeButton("Отмена", None)
                fragment_ref.showDialog(bx.create())
            except Exception as ex:
                self.note("dialog: %s" % ex)
                act_name()
        run_on_ui_thread(on_main)

    def _screen_census(self):
        tally = {"total": 0, "ours": 0}
        off_font = {}
        rg = self.registry

        def handle_view(node, face_tf, _assign):
            if node.getVisibility() != 0:
                return 0
            if rg.is_mine(face_tf):
                tally["total"] += 1
                tally["ours"] += 1
                return 0
            raw_face = rg.role_of(face_tf)
            if raw_face is not None and rg.resolve(raw_face) is None:
                return 0
            tally["total"] += 1
            nm = node.getClass().getName().rsplit(".", 1)[-1]
            off_font[nm] = off_font.get(nm, 0) + 1
            return 0
        self.view_swap.traverse(handle_view)
        return tally["total"], tally["ours"], off_font

    def _screen_check(self):
        def on_main():
            if self.registry.kit is None:
                self.say_info("Шрифт сейчас не активен")
                return
            try:
                acc, mine_n, off_font = self._screen_census()
                percent = int(mine_n * 100 / acc) if acc else 0
                self.note("screen: %d/%d (%d%%), misses: %s" % (mine_n, acc, percent, off_font))
                self.say_info("Экран: %d из %d текстов (%d%%) вашим шрифтом" % (mine_n, acc, percent))
            except Exception:
                self.note("snapshot: %s" % traceback.format_exc())
        run_on_ui_thread(on_main)

    def _diagnostics(self):
        report_lines = ["NelyFonts %s" % __version__]
        try:
            build_vars = jclass("org.telegram.messenger.BuildVars")
            report_lines.append("Приложение: %s (%s)" % (build_vars.BUILD_VERSION_STRING, build_vars.BUILD_VERSION))
        except Exception:
            pass
        report_lines.append("Android SDK: %s" % api_level())
        report_lines.append("Активен: %s" % ("да" if self.registry.kit is not None else "нет"))
        manifest = self.vault.manifest or {}
        report_lines.append("Шрифт: %s (источник: %s)" % (manifest.get("family") or "—", manifest.get("source") or "—"))
        for face in FACES:
            text_s = (manifest.get("slots") or {}).get(face)
            if text_s:
                report_lines.append("  %s: %s · %s · %s · вес %s%s" % (
                    face, text_s.get("name") or text_s.get("file"), text_s.get("format"), human_size(text_s.get("size")),
                    text_s.get("weight"), " · вариативный" if text_s.get("variable") else ""))
        if self.kit_ready is not None:
            report_lines.append("Настоящие начертания: %s" % ", ".join(face_r for face_r in FACES if face_r in self.kit_ready.genuine))
        report_lines.append("Настройки: %s" % self.prefs)
        report_lines.append("Хуки:")
        for key_, vv in self.hookset.state.items():
            report_lines.append("  %s: %s" % (key_, vv))
        report_lines.append("Paint темы: %d из %d" % (self.paint_swap.swapped, self.paint_swap.scanned))
        report_lines.append("Кеш Telegram: %d ключей, проверка: %s" % (self.cached_count, self.cache_check))
        report_lines.append("Вью обновлено: %d" % self.view_swap.swapped)
        report_lines.append("Typeface.setDefault: %s" % self.default_swap.state)
        report_lines.append("События:")
        report_lines.extend("  " + ex for ex in list(self._journal)[-25:])
        return "\n".join(report_lines)

    def _copy_diagnostics(self):
        line_text = self._diagnostics()
        copied = False
        if copy_to_clipboard is not None:
            try:
                copy_to_clipboard(line_text)
                copied = True
            except Exception:
                copied = False
        if not copied:
            try:
                copied = bool(jclass(UTILS_CLS).addToClipboard(line_text))
            except Exception:
                copied = False
        if copied:
            self.say_ok("Отчёт скопирован")
        else:
            self.say_error("Не удалось скопировать отчёт")

    def _summary_line(self):
        manifest = getattr(self, "vault", None) and self.vault.manifest
        if not manifest:
            return "Шрифт не выбран"
        reg_slot = manifest["slots"]["regular"]
        state_s = "активен" if self.registry.kit is not None else "выключен"
        extra_n = len(manifest["slots"]) - 1
        line_text = "%s — %s" % (manifest.get("family") or reg_slot.get("name") or "шрифт", state_s)
        if extra_n:
            line_text += ", +%d нач." % extra_n
        if reg_slot.get("latin") and not reg_slot.get("cyrillic"):
            line_text += " · нет кириллицы"
        return line_text

    def _inspector_page(self):
        ui_rows = [Header(text="Текущий шрифт")]
        manifest = self.vault.manifest
        if not manifest:
            ui_rows.append(Text(text="Шрифт не выбран", icon="msg_info"))
            return ui_rows
        reg_slot = manifest["slots"]["regular"]
        facts = [
            "Семейство: %s" % (manifest.get("family") or "—"),
            "Формат: %s" % reg_slot.get("format", "—"),
            "Глифов: %s" % reg_slot.get("glyphs", "—"),
            "Латиница: %s · Кириллица: %s · Цифры: %s" % tuple(
                "есть" if reg_slot.get(key_) else "нет" for key_ in ("latin", "cyrillic", "digits")),
        ]
        if reg_slot.get("variable"):
            axis_map = ", ".join("%s %g–%g" % (tt, axis_at[0], axis_at[2]) for tt, axis_at in reg_slot.get("axes", {}).items())
            facts.append("Вариативный: %s" % axis_map)
        if not reg_slot.get("cyrillic"):
            facts.append("В шрифте нет кириллицы — русские буквы будут системным шрифтом.")
        ui_rows.append(Divider(text="\n".join(facts)))
        ui_rows.append(Header(text="Начертания"))
        genuine = self.kit_ready.genuine if self.kit_ready is not None else set()
        for face in FACES:
            fslot = manifest["slots"].get(face)
            if fslot:
                descr = "%s, %s" % (fslot.get("name") or fslot.get("file"), human_size(fslot.get("size")))
            elif face in genuine:
                descr = "из осей вариативного шрифта"
            else:
                descr = "синтезируется"
            ui_rows.append(Text(text="%s: %s" % (FACE_LABEL[face], descr), icon="msg_photo_text_regular"))
        ui_rows.append(Header(text="Состояние"))
        state_s = ["Активен: %s" % ("да" if self.registry.kit is not None else "нет"),
                   "Android SDK: %s" % api_level(),
                   "Paint темы: %d из %d" % (self.paint_swap.swapped, self.paint_swap.scanned),
                   "Кеш Telegram: %d ключей, проверка: %s" % (self.cached_count, self.cache_check),
                   "Вью обновлено: %d" % self.view_swap.swapped,
                   "Typeface.setDefault: %s" % self.default_swap.state]
        for key_, vv in self.hookset.state.items():
            state_s.append("%s: %s" % (key_, vv))
        ui_rows.append(Divider(text="\n".join(state_s)))
        return ui_rows

    def _faces_page(self):
        ui_rows = [Header(text="Начертания семейства")]
        manifest = self.vault.manifest
        if not manifest:
            ui_rows.append(Text(text="Сначала выберите основной шрифт", icon="msg_info",
                                on_click=lambda *_: self._open_picker()))
            return ui_rows
        for face in FACES:
            fslot = manifest["slots"].get(face)
            state_s = (fslot.get("name") or fslot.get("file")) if fslot else "не задано"
            ui_rows.append(Text(text="%s: %s" % (FACE_LABEL[face], state_s), icon="msg_openin",
                                accent=fslot is None, on_click=lambda *_, face_r=face: self._open_picker(fslot=face_r)))
        droppable = [face_r for face_r in FACES if face_r != "regular" and face_r in manifest["slots"]]
        if droppable:
            ui_rows.append(Divider())
            for face in droppable:
                ui_rows.append(Text(text="Убрать «%s»" % FACE_LABEL[face], icon="msg_delete", red=True,
                                    on_click=lambda *_, face_r=face: self._drop_face(face_r)))
        ui_rows.append(Divider(text="Нажмите на начертание, чтобы выбрать для него файл. Незаданные начертания "
                               "синтезируются из обычного: жирный — утолщением, курсив — наклоном. "
                               "Проще всего выбрать сразу несколько файлов или ZIP с семейством — "
                               "начертания распределятся сами."))
        return ui_rows

    def _downloads_page(self):
        ui_rows = [Header(text="Шрифты из загрузок Telegram")]
        try:
            listed = self.list_downloaded()
        except Exception:
            listed = []
            self.note("scan: %s" % traceback.format_exc())
        if not listed:
            ui_rows.append(Text(text="Файлы шрифтов не найдены", icon="msg_info"))
        for fpath, caption in listed:
            ui_rows.append(Text(text=caption, icon="msg_download",
                                on_click=lambda *_, px=fpath: self.intake_async([("path", px)], via="downloads")))
        ui_rows.append(Divider(text="Отправьте .ttf/.otf/.zip в «Избранное», нажмите на файл, чтобы он скачался, "
                               "и вернитесь сюда — он появится в списке."))
        return ui_rows

    def create_settings(self):
        if Header is None:
            return []
        try:
            return self._settings_rows()
        except Exception:
            self.note("settings: %s" % traceback.format_exc())
            return [Header(text="NelyFonts"),
                    Text(text="Ошибка построения настроек — скопируйте отчёт", icon="msg_info"),
                    Text(text="Скопировать отчёт", icon="msg_copy", on_click=lambda *_: self._copy_diagnostics())]

    def _settings_rows(self):
        pref_fn = self._pref_changed
        return [
            Header(text="NelyFonts"),
            Switch(key="enabled", text="Включить NelyFonts", default=True,
                   subtext="Ваш шрифт во всём приложении — без перезапуска",
                   icon="msg_photo_text_regular", on_change=self._enabled_changed),
            Text(text=self._summary_line(), icon="msg_photo_text_framed3",
                 create_sub_fragment=self._inspector_page),
            Divider(),

            Header(text="Выбор шрифта"),
            Text(text="Выбрать файлы шрифта", icon="msg_openin", accent=True,
                 on_click=lambda *_: self._open_picker()),
            Text(text="Шрифты из загрузок Telegram", icon="msg_download",
                 create_sub_fragment=self._downloads_page),
            Input(key="font_url", text="Скачать по ссылке", default="",
                  subtext="Прямая ссылка на .ttf/.otf/.zip (GitHub, Dropbox, Google Drive…)",
                  icon="msg_link", on_change=self._link_changed),
            Text(text="Установить %s" % BUNDLED_FAMILY, icon="msg_fave",
                 on_click=lambda *_: self._install_bundled()),
            Text(text="Начертания семейства", icon="msg_list",
                 create_sub_fragment=self._faces_page),
            Divider(text="Подходят TTF, OTF, TTC и ZIP-архивы. Можно выбрать сразу несколько файлов "
                         "(Regular, Bold, Italic…) — начертания распределятся автоматически."),

            Header(text="Начертания"),
            Switch(key="medium_as_bold", text="Средний вес как жирный", default=True,
                   subtext="Для шрифтов без Medium: имена и заголовки станут жирными",
                   icon="msg_photo_text2", on_change=lambda vv: pref_fn("medium_as_bold", vv)),
            Switch(key="keep_monospace", text="Оставить моноширинный шрифт", default=True,
                   subtext="Код и `моно` в сообщениях", icon="msg_text_outlined",
                   on_change=lambda vv: pref_fn("keep_monospace", vv)),
            Switch(key="keep_serif", text="Оставить шрифт с засечками", default=False,
                   subtext="Заголовки Instant View и редактора", icon="msg_photo_text_framed",
                   on_change=lambda vv: pref_fn("keep_serif", vv)),
            Divider(),

            Header(text="Покрытие"),
            Switch(key="hook_constructors", text="Текстовые элементы при создании", default=True,
                   subtext="TextView и анимированный текст — без затрат на кадр",
                   icon="msg_customize", on_change=lambda vv: pref_fn("hook_constructors", vv)),
            Switch(key="deep_mode", text="Глубокий режим", default=False,
                   subtext="Ловит редкие места со стандартным шрифтом. Чуть больше нагрузки",
                   icon="msg_stats", on_change=lambda vv: pref_fn("deep_mode", vv)),
            Divider(),

            Header(text="Обслуживание"),
            Text(text="Применить заново", icon="msg_retry",
                 on_click=lambda *_: self._enable_saved_async("Шрифт применён заново")),
            Text(text="Перезапустить приложение", icon="msg_reset",
                 on_click=lambda *_: self._ask(
                     "Перезапуск", "Перезапустить приложение, чтобы шрифт применился везде, "
                                   "включая уже открытые чаты?", "Перезапустить", self._relaunch)),
            Text(text="Удалить шрифт", icon="msg_delete", red=True,
                 on_click=lambda *_: self._ask(
                     "Удалить шрифт", "Удалить выбранный шрифт и вернуть стандартный?",
                     "Удалить", self._forget_font)),
            Divider(),

            Header(text="Диагностика"),
            Text(text="Проверить текущий экран", icon="msg_search",
                 on_click=lambda *_: self._screen_check()),
            Text(text="Скопировать отчёт", icon="msg_copy",
                 on_click=lambda *_: self._copy_diagnostics()),
            Divider(text="NelyFonts %s · %s" % (__version__, __author__)),
        ]
